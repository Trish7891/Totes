[Unit]
Description=SafeCell contained agent execution
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=safecell
WorkingDirectory=/opt/safecell
EnvironmentFile=/opt/safecell/.env
# bubblewrap needs user namespaces; do not add filesystem sandboxing here that
# blocks clone(CLONE_NEW*) or the service cannot create cells at all.
ExecStart=/opt/safecell/.venv/bin/uvicorn safecell.api:app --host ${SAFECELL_HOST} --port ${SAFECELL_PORT}
Restart=always
RestartSec=2
NoNewPrivileges=yes
# Binding to :80 as a non-root user needs exactly this one capability and
# nothing more. Without it uvicorn dies with EACCES and systemd restart-loops.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/safecell

[Install]
WantedBy=multi-user.target
